# Dataset de Kaggle y salidas del motor (≈500 MB): la app solo necesita semilla/.
datos/
# Llaves y configuración local: nunca al repositorio (la plantilla es .env.example).
.env
# Entornos y cachés de Python.
.venv/
__pycache__/
*.pyc
.pytest_cache/
# Modelos entrenados y paquetes de entrega (se regeneran).
*.joblib
# Excepción: el modelo que la app usa para puntuar en vivo (≈5 MB) sí va al repositorio,
# porque un clon limpio no tiene el dataset para entrenarlo (SPEC, RF1).
!semilla/modelo_riesgo_sparkov.joblib
*.zip

# Variantes locales del .env (auditoría B7); la plantilla sí va al repositorio.
.env.*
!.env.example
