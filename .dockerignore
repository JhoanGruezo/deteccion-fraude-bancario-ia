# Lo que NO entra a la imagen de la app. La imagen necesita app/, src/ y semilla/.

# Datos de Kaggle y salidas del motor (cientos de MB; la app usa semilla/).
datos/
*.csv
*.joblib
# Excepción: el modelo con el que la app puntúa en vivo.
!semilla/modelo_riesgo_sparkov.joblib

# Llaves de API: nunca dentro de una imagen; llegan por variables de entorno.
.env

# Entornos y cachés de Python.
.venv/
venv/
**/__pycache__/
*.pyc
.pytest_cache/

# Control de versiones y herramientas del equipo.
.git/
.claude/

# Variantes locales del .env y la documentación: no hacen falta para construir la imagen
# (auditoría B7: docs/ llevaba al contexto de build un archivo local con llaves).
.env.*
!.env.example
docs/
