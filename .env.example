# Configuración de la app del analista. run.sh copia este archivo a .env si no existe.
# Las llaves de API van SOLO en .env (que no se entrega ni entra a la imagen); este
# archivo nunca lleva valores de llaves.

# --- Proveedores de IA --------------------------------------------------------------
# Sin llaves la app funciona igual: la explicación sale de la plantilla armada solo
# con las desviaciones guardadas del caso (y la interfaz lo dice).
# Llave de Anthropic (Claude Haiku 5.5, proveedor PRINCIPAL): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Llave de Gemini (Gemini 3.1 Flash-Lite, proveedor de RESPALDO): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Por qué este orden (medido el 2026-10-21): ver "Actualización 2026-10-21 (3)" en decisiones.md.
GEMINI_MODELO=gemini-3.1-flash-lite
CLAUDE_MODELO=claude-haiku-5-5
# Razonamiento extendido de Claude (true lo activa; más lento y más tokens).
CLAUDE_RAZONAMIENTO=false
# Orden de la cascada: el primero es el principal, el resto son respaldos.
ORDEN_PROVEEDORES=claude,gemini

# --- Base de datos ------------------------------------------------------------------
# Contraseña del Postgres del docker-compose (valor solo de desarrollo; cámbiela si
# quiere, antes del primer arranque: el volumen guarda la que se usó al crearlo).
POSTGRES_PASSWORD=fraude_dev
# Vacía = docker compose la arma con POSTGRES_PASSWORD apuntando al servicio "db".
# Solo se llena para usar otra base, p. ej. postgresql://usuario:clave@host:5432/fraude
DATABASE_URL=

# --- Límites del agente (diseno/agente.md) -------------------------------------------
# Llamadas al modelo por tarea.
MAX_ITERACIONES=6
# Tokens de entrada + salida acumulados por tarea.
PRESUPUESTO_TOKENS=40000
# Segundos máximos por llamada al modelo y por herramienta.
TIMEOUT_MODELO_S=25
TIMEOUT_HERRAMIENTA_S=5
# Tokens máximos de cada respuesta del modelo.
MAX_TOKENS_RESPUESTA=2500
# Esperas del backoff ante 429/5xx/timeout, en segundos, antes de conmutar de proveedor.
ESPERAS_REINTENTO_S=1,2,4

# --- Fallas forzadas para la demo -----------------------------------------------------
# Vacío = sin falla. Valores: 429 | timeout | json | todo
FALLA_FORZADA=
# true = el panel de demo de la interfaz puede elegir la falla en vivo.
PERMITIR_FALLAS_DESDE_UI=true
